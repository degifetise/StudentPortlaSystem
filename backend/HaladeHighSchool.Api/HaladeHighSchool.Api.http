@HaladeHighSchool.Api_HostAddress = http://localhost:5006

### Sign in as the seeded administrator
# Set adminEmail and adminPassword in your local REST Client environment.
# @name login
POST {{HaladeHighSchool.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Capture the token from the login response
@token = {{login.response.body.accessToken}}

### Admin: look up a user by Student ID, Employee ID, or staff email
GET {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/admin/users/replace-with-student-or-employee-id
Authorization: Bearer {{token}}

### Admin: list issued and pending Smart IDs
GET {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/admin/cards?search=&role=student
Authorization: Bearer {{token}}

### Admin: issue one user's Smart ID (use the UserId returned by lookup)
POST {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/admin/users/replace-with-user-id/generate
Authorization: Bearer {{token}}

### Admin: update an issued Smart ID and rotate its QR signing secret
PUT {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/admin/cards/replace-with-user-id
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Updated cardholder name",
  "status": "ACTIVE",
  "rotateQrToken": true
}

### Admin: revoke a Smart ID (only use a disposable test card)
DELETE {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/admin/cards/replace-with-user-id
Authorization: Bearer {{token}}

### Admin: generate cards for selected student accounts
# Replace the placeholder with one or more existing student UserIds. Requests are limited to 100.
POST {{HaladeHighSchool.Api_HostAddress}}/api/smart-id/generate-cards?role=student
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userIds": ["replace-with-student-user-id"]
}

### Current profile
GET {{HaladeHighSchool.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### Student roster
GET {{HaladeHighSchool.Api_HostAddress}}/api/students?page=1&pageSize=25
Authorization: Bearer {{token}}

### Roster counts per grade and section
GET {{HaladeHighSchool.Api_HostAddress}}/api/students/summary
Authorization: Bearer {{token}}

### Approve a pending student registration (replace 1 with a pending request ID)
POST {{HaladeHighSchool.Api_HostAddress}}/api/admin/approve-student/1
Authorization: {{token}}
Content-Type: application/json

{
  "note": "Documents verified"
}

### Enrol a student (use an active grade and section ID)
POST {{HaladeHighSchool.Api_HostAddress}}/api/students
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Lensa Tolera",
  "gradeLevelId": 2,
  "sectionId": 1,
  "gender": "Female",
  "dateOfBirth": "2010-04-11",
  "guardianName": "Tolera G."
}

### Move a student to another grade or section
PUT {{HaladeHighSchool.Api_HostAddress}}/api/students/1/assignment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "gradeLevelId": 2,
  "sectionId": 2
}

### Issue a new temporary password
POST {{HaladeHighSchool.Api_HostAddress}}/api/students/1/reset-password
Authorization: Bearer {{token}}

### Assessment weighting (Quiz 10, Assignment 10, Test 20, MidExam 30, FinalExam 30)
GET {{HaladeHighSchool.Api_HostAddress}}/api/marks/weights
Authorization: Bearer {{token}}

### Mark-entry sheet for an assessment
GET {{HaladeHighSchool.Api_HostAddress}}/api/marks/assessment/1
Authorization: Bearer {{token}}

### Enter a whole class at once
POST {{HaladeHighSchool.Api_HostAddress}}/api/marks/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assessmentId": 1,
  "isPublished": false,
  "entries": [
    { "studentId": 1, "score": 80, "remark": "Good work" }
  ]
}

### Publish every mark for an assessment
PUT {{HaladeHighSchool.Api_HostAddress}}/api/marks/assessment/1/publish
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isPublished": true
}

### Weighted report card for a student
GET {{HaladeHighSchool.Api_HostAddress}}/api/marks/student/1/report-card
Authorization: Bearer {{token}}

### Student's own published marks (requires a student token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/marks/me
Authorization: Bearer {{token}}

### Rotate the access token
POST {{HaladeHighSchool.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}

### School-wide analytics (Admin token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/admin/analytics/overview
Authorization: Bearer {{token}}

# Set teacherToken to an access token from /api/auth/login for an account with the Teacher role.
### Assigned-class performance analytics (Teacher token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/teacher/analytics/performance
Authorization: Bearer {{teacherToken}}

### Download personal academic results (Student token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/assessments/my-results/pdf
Authorization: Bearer {{studentToken}}

### Download the full student roster (Admin token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/admin/reports/students/pdf
Authorization: Bearer {{token}}

### Download a Grade 10, Section A roster (Admin token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/admin/reports/students/pdf?gradeLevelId=2&sectionId=1
Authorization: Bearer {{token}}

### Download the faculty directory (Admin token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/admin/reports/teachers/pdf
Authorization: Bearer {{token}}

### Download an assigned section roster (Teacher token)
GET {{HaladeHighSchool.Api_HostAddress}}/api/teacher/reports/section/1/pdf
Authorization: Bearer {{teacherToken}}
